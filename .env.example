# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# DATABASE_URL: the "Transaction pooler" connection string (port 6543) — used by the app on Vercel.
# DIRECT_URL:   the "Session pooler" (port 5432) or direct string — used for migrations.
# Supabase dashboard → Connect → Connection string.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://teasoo:teasoo@localhost:5432/teasoo_expense
DIRECT_URL=

# Long random string used to sign session tokens:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used for Google redirect, email links). No trailing slash.
APP_URL=http://localhost:3000
ORGANISATION_NAME=Teasoo Consulting

# ---------------------------------------------------------------------------
# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, "Web application")
# Authorised redirect URI: {APP_URL}/api/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COMPANY_EMAIL_DOMAIN=teasooconsulting.com
# Emails that become administrators the first time they sign in with Google (comma-separated)
BOOTSTRAP_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Email via Resend (resend.com → API Keys). Verify teasooconsulting.com under Domains first.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Teasoo Expense <notifications@teasooconsulting.com>

# ---------------------------------------------------------------------------
# Receipt storage. "local" for development; "supabase" in production.
# SUPABASE_SERVICE_ROLE_KEY is secret — server only, never expose it to the browser.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_DIR=./storage/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=receipts
