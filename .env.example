# PostgreSQL connection string
DATABASE_URL=postgres://teasoo:teasoo@localhost:5432/teasoo_expense

# Long random string used to sign session tokens (openssl rand -base64 48)
AUTH_SECRET=change-me-to-a-long-random-string

# Where uploaded receipts are stored when STORAGE_DRIVER=local
STORAGE_DRIVER=local
STORAGE_DIR=./storage/uploads

# Public URL of the app (used in password reset links)
APP_URL=http://localhost:3000
