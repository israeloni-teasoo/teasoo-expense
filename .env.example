# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# DATABASE_URL: the "Pooled connection" string (host contains "-pooler") — used by the app on Vercel.
# DIRECT_URL:   the direct string (pooling switched off) — used for migrations.
# Neon console → your project → Connect. The Neon Vercel integration sets DATABASE_URL and
# DATABASE_URL_UNPOOLED for you; DATABASE_URL_UNPOOLED is used for migrations when DIRECT_URL is empty.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://teasoo:teasoo@localhost:5432/teasoo_expense
DIRECT_URL=

# Long random string used to sign session tokens:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used for Google redirect, email links). No trailing slash.
APP_URL=http://localhost:3000
ORGANISATION_NAME=Teasoo Consulting

# ---------------------------------------------------------------------------
# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, "Web application")
# Authorised redirect URI: {APP_URL}/api/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COMPANY_EMAIL_DOMAIN=teasooconsulting.com
# Emails that become administrators the first time they sign in with Google (comma-separated)
BOOTSTRAP_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Email via Resend (resend.com → API Keys). EMAIL_FROM must use the domain verified under Domains (expense.teasooconsulting.com).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Teasoo Expense <notifications@expense.teasooconsulting.com>

# ---------------------------------------------------------------------------
# Receipt storage. "local" for development; "supabase" in production.
# (Receipt files stay in Supabase Storage — Neon is the database only and has no file storage.)
# SUPABASE_SERVICE_ROLE_KEY is secret — server only, never expose it to the browser.
# ---------------------------------------------------------------------------
# Leave unset: "supabase" is used automatically when SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set.
STORAGE_DRIVER=
STORAGE_DIR=./storage/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=receipts
